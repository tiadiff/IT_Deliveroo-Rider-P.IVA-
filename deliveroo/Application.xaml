<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:deliveroo"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- DEFAULT BRUSHES (Default Dark) -->
        <SolidColorBrush x:Key="BgWindow" Color="#18181B"/>
        <SolidColorBrush x:Key="BgCard" Color="#27272A"/>
        <SolidColorBrush x:Key="BgInput" Color="#27272A"/>
        <SolidColorBrush x:Key="BorderInput" Color="#3F3F46"/>
        <SolidColorBrush x:Key="FgText" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="FgMuted" Color="#A1A1AA"/>

        <!-- Tabs -->
        <SolidColorBrush x:Key="BgTabControl" Color="#18181B"/>
        <SolidColorBrush x:Key="BgTabItem" Color="#27272A"/>
        <SolidColorBrush x:Key="BgTabItemSelected" Color="#18181B"/>
        <SolidColorBrush x:Key="BgTabItemHover" Color="#323236"/>
        <SolidColorBrush x:Key="FgTabItem" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="FgTabItemSelected" Color="#FFFFFF"/>

        <!-- Griglia -->
        <SolidColorBrush x:Key="BgDataGridHeader" Color="#27272A"/>
        <SolidColorBrush x:Key="BgDataGridRow" Color="#18181B"/>
        <SolidColorBrush x:Key="BgDataGridRowAlt" Color="#222225"/>
        <SolidColorBrush x:Key="DataGridGridLines" Color="#3F3F46"/>

        <!-- Box Statistiche -->
        <SolidColorBrush x:Key="BgCardLordo" Color="#142918"/>
        <SolidColorBrush x:Key="BorderCardLordo" Color="#4CAF50"/>
        <SolidColorBrush x:Key="FgCardLordo" Color="#81C784"/>

        <SolidColorBrush x:Key="BgCardNettoB" Color="#0C233C"/>
        <SolidColorBrush x:Key="BorderCardNettoB" Color="#2196F3"/>
        <SolidColorBrush x:Key="FgCardNettoB" Color="#64B5F6"/>

        <SolidColorBrush x:Key="BgCardSpese" Color="#331D0C"/>
        <SolidColorBrush x:Key="BorderCardSpese" Color="#FF9800"/>
        <SolidColorBrush x:Key="FgCardSpese" Color="#FFB74D"/>

        <SolidColorBrush x:Key="BgCardNettoR" Color="#0B2644"/>
        <SolidColorBrush x:Key="BorderCardNettoR" Color="#42A5F5"/>
        <SolidColorBrush x:Key="FgCardNettoR" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubFgCardNettoR" Color="#90CAF9"/>

        <SolidColorBrush x:Key="BgCard730" Color="#26112C"/>
        <SolidColorBrush x:Key="BorderCard730" Color="#AB47BC"/>
        <SolidColorBrush x:Key="FgCard730" Color="#CE93D8"/>

        <SolidColorBrush x:Key="BgCardTotale730" Color="#0B2B26"/>
        <SolidColorBrush x:Key="BorderCardTotale730" Color="#00BFA5"/>
        <SolidColorBrush x:Key="FgCardTotale730" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubFgCardTotale730" Color="#64FFDA"/>

        <SolidColorBrush x:Key="BgBadgeVoto" Color="#381313"/>
        <SolidColorBrush x:Key="BorderBadgeVoto" Color="#EF5350"/>
        <SolidColorBrush x:Key="FgBadgeVoto" Color="#EF5350"/>

        <SolidColorBrush x:Key="FgStatsLabels" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="BtnThemeBg" Color="#27272A"/>
        <SolidColorBrush x:Key="BtnThemeFg" Color="#F4F4F5"/>

        <!-- Control Styles -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgText}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- DatePickerTextBox Style per Dark/Light Mode -->
        <Style TargetType="primitives:DatePickerTextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:DatePickerTextBox">
                        <Grid SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Background="{DynamicResource BgInput}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
        </Style>

        <!-- ToggleButton per ComboBox (Disegna sfondo, bordo e freccia) -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="4"
                        Background="{DynamicResource BgInput}"
                        BorderBrush="{DynamicResource BorderInput}"
                        BorderThickness="1" />
                <Border Grid.Column="0"
                        Margin="1"
                        Background="{DynamicResource BgInput}"
                        CornerRadius="3,0,0,3" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{DynamicResource FgText}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgTabItemHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgTabItemHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource FgMuted}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Padding="8,5"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource BgInput}"
                                TextBlock.Foreground="{DynamicResource FgText}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full ComboBox Style with Custom Dark/Light Template -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,4,23,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource BgInput}"
                                            BorderBrush="{DynamicResource BorderInput}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem Style with Full ControlTemplate -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgTabItem}"/>
            <Setter Property="Background" Value="{DynamicResource BgTabItem}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6,6,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgTabItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgTabItemSelected}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgTabItemSelected}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl Style with Full ControlTemplate -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgTabControl}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab Header Strip -->
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Panel.ZIndex="1"
                                      Margin="0,0,0,-1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Background="Transparent"/>
                            <!-- Tab Content Area -->
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,6,6,6"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BgDataGridRow}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgDataGridRowAlt}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridLines}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DataGridGridLines}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgDataGridHeader}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource FgText}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
